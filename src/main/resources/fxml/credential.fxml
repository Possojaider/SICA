<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<DialogPane xmlns:fx="http://javafx.com/fxml/1" headerText="Credencial temporal de visita">
  <buttonTypes><ButtonType fx:constant="CLOSE"/></buttonTypes>
  <content>
    <VBox spacing="12" alignment="CENTER">
      <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
      <Label fx:id="visit" styleClass="page-title"/>
      <Label fx:id="expires" wrapText="true"/>
      <ImageView fx:id="qr" fitWidth="320" fitHeight="320" preserveRatio="true"/>
      <TextField fx:id="code" editable="false" prefWidth="460"/>
      <Label text="Válido para un solo ingreso dentro del horario autorizado." wrapText="true" styleClass="muted"/>
      <Button fx:id="save" text="Guardar imagen PNG" styleClass="primary"/>
      <Label fx:id="message" wrapText="true"/>
    </VBox>
  </content>
</DialogPane>
