<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<DialogPane xmlns:fx="http://javafx.com/fxml/1" id="sica-form" prefWidth="650">
  <buttonTypes><ButtonType text="Guardar" buttonData="OK_DONE"/><ButtonType fx:constant="CANCEL"/></buttonTypes>
  <content>
    <GridPane hgap="16" vgap="12">
      <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
      <columnConstraints><ColumnConstraints minWidth="170" prefWidth="190"/><ColumnConstraints minWidth="310" hgrow="ALWAYS"/></columnConstraints>
      <children>
        <Label fx:id="docLabel" text="Documento" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="doc" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label fx:id="nameLabel" text="Nombre completo" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="name" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label fx:id="typeLabel" text="Tipo" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="type" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label fx:id="companyLabel" text="Empresa" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="company" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label fx:id="photoLabel" text="Foto · URL HTTPS" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="photo" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label fx:id="stateLabel" text="Acceso" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <ComboBox fx:id="state" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <Label fx:id="formError" id="form-error" wrapText="true" styleClass="error" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="6"/>
      </children>
    </GridPane>
  </content>
</DialogPane>
