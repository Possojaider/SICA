<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<DialogPane xmlns:fx="http://javafx.com/fxml/1" id="sica-form" prefWidth="650">
  <buttonTypes><ButtonType text="Guardar" buttonData="OK_DONE"/><ButtonType fx:constant="CANCEL"/></buttonTypes>
  <content>
    <GridPane hgap="16" vgap="12">
      <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
      <columnConstraints><ColumnConstraints minWidth="170" prefWidth="190"/><ColumnConstraints minWidth="310" hgrow="ALWAYS"/></columnConstraints>
      <children>
        <Label fx:id="nitLabel" text="NIT" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nit" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label fx:id="nameLabel" text="Nombre" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="name" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label fx:id="contactLabel" text="Contacto principal" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="contact" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label fx:id="activeLabel" text="Estado" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="active" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label fx:id="formError" id="form-error" wrapText="true" styleClass="error" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4"/>
      </children>
    </GridPane>
  </content>
</DialogPane>
