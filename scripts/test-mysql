#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ -f .env ]; then
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            MYSQL_ROOT_PASSWORD=*) [ "${MYSQL_ROOT_PASSWORD+x}" = x ] || export "$line" ;;
            SICA_DB_PORT=*) [ "${SICA_DB_PORT+x}" = x ] || export "$line" ;;
        esac
    done < .env
fi
docker compose up -d --wait
export SICA_TEST_DB_PASSWORD="${MYSQL_ROOT_PASSWORD:?Define MYSQL_ROOT_PASSWORD en .env}"
export SICA_TEST_DB_URL="jdbc:mysql://127.0.0.1:${SICA_DB_PORT:-3306}/?connectionTimeZone=America/Bogota&connectTimeout=5000&socketTimeout=15000"
exec ./mvnw test "$@"
