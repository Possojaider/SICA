#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ -f .env ]; then
    # Las variables se leen como valores literales. El archivo no ejecuta comandos.
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        case "$line" in
          SICA_DB_USER=*|SICA_DB_PASSWORD=*|SICA_DB_URL=*|SICA_ZONE=*|SICA_ADMIN_EMAIL=*|SICA_ADMIN_PASSWORD=*|MYSQL_ROOT_PASSWORD=*|SICA_DB_PORT=*)
            export "$line" ;;
        esac
    done < .env
fi
exec ./mvnw javafx:run "-Djavafx.args=$*"
